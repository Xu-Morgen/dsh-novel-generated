{
  "schemaVersion": 1,
  "namespace": "novelWorkspace",
  "docxUpload": {
    "methods": [
      { "id": "novel-creation-tool/novelWorkspace/uploadStart", "input": ["UploadStartInput"], "result": "UploadStartResult" },
      { "id": "novel-creation-tool/novelWorkspace/uploadChunk", "input": ["uploadId", "index", "base64"], "result": "UploadChunkResult" },
      { "id": "novel-creation-tool/novelWorkspace/uploadFinalize", "input": ["uploadId"], "result": "UploadFinalizeResult" },
      { "id": "novel-creation-tool/novelWorkspace/uploadCancel", "input": ["uploadId"], "result": "{ ok: true }" }
    ],
    "shapeIds": ["UploadStartInput", "UploadStartResult", "UploadChunkResult", "UploadFinalizeResult", "DocxTextChunk"]
  },
  "limits": {
    "maxCompressedBytes": 10485760,
    "maxEntries": 4096,
    "maxEntryUncompressedBytes": 67108864,
    "maxTotalUncompressedBytes": 268435456,
    "maxCompressionRatio": 1000
  },
  "retired": {
    "handWrittenDocxParser": "removed-in-I51",
    "referenceCheck": "no lingering references to readDocx/inflateRawSync/xmlText in src"
  }
}
