{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "number",
      "const": 1
    },
    "requests": {
      "maxItems": 30,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "status": {
            "type": "string",
            "enum": [
              "connecting",
              "reasoning",
              "generating",
              "complete",
              "failed",
              "cancelled"
            ]
          },
          "text": {
            "type": "string",
            "maxLength": 16000
          },
          "reasoning": {
            "type": "string",
            "maxLength": 16000
          },
          "error": {
            "type": "string",
            "maxLength": 300
          }
        },
        "required": [
          "id",
          "status",
          "text",
          "reasoning",
          "error"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "version",
    "requests"
  ],
  "additionalProperties": false
}
