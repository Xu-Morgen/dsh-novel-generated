      "namespace": "novelImportInterpretationAnalysis",
      "method": "begin",
      "invocation": {
        "kind": "direct"
      },
      "parameters": [
        {
          "name": "input",
          "wire": "input",
          "source": "json",
          "codec": {
            "mode": "strict",
            "typeSymbol": "novel-creation-tool#importInterpretationInput",
            "schema": {
              "$schema": "https://json-schema.org/draft/2020-12/schema",
              "type": "object",
              "properties": {
                "projectId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64
                },
                "importSessionId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64
                },
                "sourceHash": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "paragraphs": {
                  "minItems": 1,
                  "maxItems": 200,
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "paragraphId": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 200
                      },
                      "index": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      },
                      "text": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 20000
                      },
                      "startOffset": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      },
                      "endOffset": {
                        "type": "integer",
                        "exclusiveMinimum": 0,
                        "maximum": 9007199254740991
                      }
                    },
                    "required": [
                      "paragraphId",
                      "index",
                      "text",
                      "startOffset",
                      "endOffset"
                    ],
                    "additionalProperties": false
                  }
                }
              },
              "required": [
                "projectId",
                "importSessionId",
                "sourceHash",
                "paragraphs"
              ],
              "additionalProperties": false
            }
          },
          "_optional": false
        },
        {
          "name": "settings",
          "wire": "settings",
          "source": "json",
          "codec": {
            "mode": "strict",
            "typeSymbol": "novel-creation-tool#json",
            "schema": {
              "$schema": "https://json-schema.org/draft/2020-12/schema"
            }
          },
          "_optional": true,
          "acceptsUndefined": true
        }
      ],
